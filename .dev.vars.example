# Copy to .dev.vars. Use random values, never commit real secrets.
PLATFORM_API_KEY=replace-with-a-random-key-at-least-32-characters
TELEGRAM_BOT_TOKEN=replace-with-BotFather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TRIBUTE_API_KEY=replace-with-Tribute-API-key

# Optional: client domains only. Scope to the dedicated Cloudflare for SaaS zone.
# CUSTOM_DOMAINS_API_TOKEN=replace-with-scoped-Cloudflare-API-token
