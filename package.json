{
  "name": "f1demo-catalog-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "db:migrate": "wrangler d1 migrations apply catalog-factory --local",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "tsc --noEmit",
    "types": "wrangler types --include-runtime=false",
    "build": "wrangler deploy --dry-run",
    "store": "node scripts/store.js",
    "test:browser": "node tests/browser-smoke.js && node tests/browser-tribute-digital.js",
    "telegram:setup": "node scripts/telegram-setup.js",
    "format": "prettier --write src public scripts/*.js tests *.json wrangler.jsonc README.md docs .github",
    "format:check": "prettier --check src public scripts/*.js tests *.json wrangler.jsonc README.md docs .github",
    "deploy:cloudflare": "node scripts/cloudflare-deploy.js",
    "dev:staging": "wrangler dev --env staging --local",
    "build:staging": "wrangler deploy --env staging --dry-run",
    "deploy:staging": "DEPLOY_TARGET=staging node scripts/cloudflare-deploy.js",
    "release:list": "node scripts/release.js list",
    "release:rollback": "node scripts/release.js rollback",
    "release:backup": "node scripts/release.js backup"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20261006.1-alpha",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
