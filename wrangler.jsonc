{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-factory",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/demo/*", "/shop/*", "/media/*", "/admin", "/admin/*", "/"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog-factory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "catalog-factory-images",
    },
  ],
  "vars": {
    "BOT_USERNAME": "",
    "PUBLIC_ORIGIN": "http://localhost:8787",
  },
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "secrets": {
    "required": ["PLATFORM_API_KEY", "TELEGRAM_BOT_TOKEN", "TELEGRAM_WEBHOOK_SECRET"],
  },
}
