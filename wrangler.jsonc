{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-factory",
  "main": "src/index.ts",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/platform.js",
        "**/storefront.js",
        "**/storefront.html",
        "**/favicon.svg",
        "**/admin.js",
        "**/admin-i18n.js",
        "**/admin.css",
        "**/storefront.css",
        "**/admin.html",
        "**/platform.html",
        "**/platform-editor.html",
      ],
      "fallthrough": false,
    },
  ],
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog-factory-staging",
      "database_id": "31f3247d-d1c6-4767-99d7-7dad609a7d12",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "catalog-factory-staging-images",
    },
    { "binding": "LEGACY_IMAGES", "bucket_name": "catalog-factory-images" },
  ],
  "services": [
    {
      "binding": "LEGACY_ADMIN_AUTH",
      "service": "catalog-factory-staging",
      "entrypoint": "LegacyDeveloperServices",
    },
    {
      "binding": "LEELA_PAYMENTS",
      "service": "leela-worker",
    },
  ],
  "vars": {
    "BOT_USERNAME": "",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "TRIBUTE_SHOP_ID": "",
    "TRIBUTE_PRODUCT_URL": "https://web.tribute.tg/p/H0x",
    "DEPLOYMENT_ENV": "production",
    "IMPORT_API_ORIGIN": "https://delokay-import-staging-production.up.railway.app",
  },
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "secrets": {
    "required": [
      "PLATFORM_API_KEY",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "TRIBUTE_API_KEY",
    ],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "env": {
    "staging": {
      "name": "catalog-factory-staging",
      "vars": {
        "BOT_USERNAME": "delokay_bot",
        "PUBLIC_ORIGIN": "https://catalog-factory-staging.nikita-karpof.workers.dev",
        "TRIBUTE_SHOP_ID": "",
        "TRIBUTE_PRODUCT_URL": "",
        "DEPLOYMENT_ENV": "staging",
        "AUTH_VERIFIER_ORIGIN": "https://catalog-factory.nikita-karpof.workers.dev",
        "CANONICAL_ORIGIN": "https://catalog-factory.nikita-karpof.workers.dev",
        "IMPORT_API_ORIGIN": "https://delokay-import-staging-production.up.railway.app",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "catalog-factory-staging",
          "database_id": "31f3247d-d1c6-4767-99d7-7dad609a7d12",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "catalog-factory-staging-images",
        },
      ],
      "services": [
        {
          "binding": "AUTH_VERIFIER",
          "service": "catalog-factory",
        },
      ],
      "triggers": {
        "crons": [],
      },
      "secrets": {
        "required": ["PLATFORM_API_KEY", "IMPORT_API_TOKEN"],
      },
    },
  },
}
