{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-factory",
  "main": "src/index.ts",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/platform.js",
        "**/admin.js",
        "**/admin.html",
        "**/platform.html",
        "**/platform-editor.html",
      ],
      "fallthrough": false,
    },
  ],
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/demo/*",
      "/templates/*",
      "/shop/*",
      "/media/*",
      "/admin",
      "/admin/*",
      "/admin.html",
      "/admin.js",
      "/platform",
      "/platform/*",
      "/platform.html",
      "/platform.js",
      "/platform-editor.html",
      "/",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog-factory",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "catalog-factory-images",
    },
  ],
  "services": [{ "binding": "LEELA_PAYMENTS", "service": "leela-worker" }],
  "vars": {
    "BOT_USERNAME": "",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "TRIBUTE_SHOP_ID": "",
    "TRIBUTE_PRODUCT_URL": "https://web.tribute.tg/p/H0x",
  },
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "secrets": {
    "required": [
      "PLATFORM_API_KEY",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "TRIBUTE_API_KEY",
    ],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
